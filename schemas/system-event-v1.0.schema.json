{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "System Event v1.0",
  "type": "object",
  "required": [
    "schema_version",
    "content_type",
    "id",
    "event_type",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "content_type": {
      "const": "system_event"
    },
    "id": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "recipient_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "priority": {
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ]
    },
    "presentation": {
      "enum": [
        "history",
        "popup",
        "banner",
        "voice",
        "silent"
      ]
    },
    "acknowledgement_required": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "queued",
        "delivered",
        "acknowledged",
        "recorded",
        "failed"
      ]
    },
    "related_object_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "related_object_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "source_authority": {
      "type": "string"
    }
  }
}